                    <xpath>Defs/ThingDef[defName="Prestige_VacSlipsuit"]/statBases/Insulation_Cold</xpath>
                    <value>
                        <Insulation_Cold>70</Insulation_Cold>
                    </value>
                </li>
                <li Class="PatchOperationReplace">
                    <xpath>Defs/ThingDef[defName="Prestige_VacSlipsuit"]/statBases/Insulation_Heat</xpath>

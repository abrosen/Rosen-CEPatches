<?xml version="1.0" encoding="utf-8"?>
<Patch>
	<Operation Class="PatchOperationFindMod">
		<mods>
			<li>Tactical Non-nonsense for Combat Extended</li>
		</mods>
		<match Class="PatchOperationSequence">
			<operations>
				<li Class="PatchOperationReplace">
					<xpath>Defs/ThingDef[defName="AX_Gun_GAKxUBS"]/label</xpath>
					<value>
						<label>combination assault rifle</label>
					</value>
				</li>
				<li Class="PatchOperationRemove">
					<xpath>Defs/ThingDef[defName="AX_Gun_GAKxFlameblaster"]</xpath>
				</li>
				<li Class="PatchOperationRemove">
					<xpath>Defs/ThingDef[defName="AX_Gun_FAMAE"]</xpath>
				</li>
				<li Class="PatchOperationReplace">
					<xpath>Defs/ThingDef[defName="AX_Gun_FAMAExDartgun"]/label</xpath>
					<value>
						<label>combination SMG</label>
					</value>
				</li>
                <li Class="PatchOperationReplace">
					<xpath>Defs/ThingDef[defName="AX_Gun_GARxSix"]/label</xpath>
					<value>
						<label>combination battle rifle</label>
					</value>
				</li>
                <li Class="PatchOperationReplace">
					<xpath>Defs/ThingDef[defName="AX_Gun_GARxFlameblaster"]/label</xpath>
					<value>
						<label>flameblaster assault rifle</label>
					</value>
				</li>
			</operations>
		</match>
	</Operation>
</Patch>
			</tags>
			<defaultOutfitTags>
				<li>Soldier</li>
			</defaultOutfitTags>
		</apparel>
		<modExtensions>
			<li Class="CombatExtended.PartialArmorExt">
				<stats>
					<li>
						<ArmorRating_Sharp>0.4</ArmorRating_Sharp>
						<parts>
							<li>Eye</li>
						</parts>
					</li>
					<li>
						<ArmorRating_Blunt>0.4</ArmorRating_Blunt>
						<parts>
							<li>Eye</li>
						</parts>
					</li>
					<li>
						<ArmorRating_Sharp>0.4</ArmorRating_Sharp>
						<parts>
							<li>Nose</li>
						</parts>
					</li>
					<li>
						<ArmorRating_Blunt>0.4</ArmorRating_Blunt>
						<parts>
							<li>Nose</li>
						</parts>
					</li>
					<li>
						<ArmorRating_Sharp>0.8</ArmorRating_Sharp>
						<parts>
							<li>Jaw</li>
						</parts>
					</li>
					<li>
						<ArmorRating_Blunt>0.8</ArmorRating_Blunt>
						<parts>
							<li>Jaw</li>
						</parts>
					</li>
					<li>
						<ArmorRating_Sharp>0.6</ArmorRating_Sharp>
						<parts>
							<li>Neck</li>
						</parts>
					</li>
					<li>
						<ArmorRating_Blunt>0.4</ArmorRating_Blunt>
						<parts>
							<li>Neck</li>
						</parts>
					</li>
				</stats>
			</li>
		</modExtensions>
		<colorGenerator Class="ColorGenerator_StandardApparel" />
		<tradeTags>
			<li>Armor</li>
		</tradeTags>
	</ThingDef>

	<ThingDef ParentName="ArmorMachineableBase">
		<defName>Rosen_Apparel_CompositeVest</defName>
		<label>composite vest</label>
		<description>A vest with armor plates inserted on the chest and back. The composite ceramics offer better protection than steel but aren't as durable.</description>
		<techLevel>Industrial</techLevel>
		<possessionCount>1</possessionCount>
		<recipeMaker>
			<researchPrerequisite>FlakArmor</researchPrerequisite>
			<skillRequirements>
				<Crafting>5</Crafting>
			</skillRequirements>
			<unfinishedThingDef>UnfinishedTechArmor</unfinishedThingDef>
		</recipeMaker>
		<graphicData>
			<texPath>Things/Apparel/CompositeVest/CompositeVest</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<statBases>
			<WorkToMake>10800</WorkToMake>
			<MaxHitPoints>75</MaxHitPoints>
			<ArmorRating_Sharp>14</ArmorRating_Sharp>
			<ArmorRating_Blunt>21</ArmorRating_Blunt>
			<Mass>10</Mass>
			<Bulk>5</Bulk>
			<WornBulk>3</WornBulk>
			<EquipDelay>5</EquipDelay>
		</statBases>
		<thingCategories>
			<li>ApparelArmor</li>
		</thingCategories>
		<costList>
			<Steel>60</Steel>
			<DevilstrandCloth>20</DevilstrandCloth>
		</costList>
		<generateCommonality>0.67</generateCommonality>
		<apparel>
			<bodyPartGroups>
				<li>Torso</li>
				<li>Neck</li>
			</bodyPartGroups>
			<wornGraphicPath>Things/Apparel/CompositeVest/CompositeVest</wornGraphicPath>
			<layers>
				<li>Middle</li>
			</layers>
			<tags>
				<li>IndustrialMilitaryBasic</li>
			</tags>
			<defaultOutfitTags>
				<li>Soldier</li>
			</defaultOutfitTags>
		</apparel>
		<colorGenerator Class="ColorGenerator_Options">
			<options>
				<li>
					<weight>10</weight>
					<only>RGBA(0.33,0.33,0.33,1)</only>
				</li>
				<li>
					<weight>10</weight>
					<only>RGBA(0.65,0.65,0.65,1)</only>
				</li>
				<li>
					<weight>6</weight>
					<min>RGBA(0.3,0.3,0.3,1)</min>
					<max>RGBA(0.5,0.5,0.5,1)</max>
				</li>
			</options>
		</colorGenerator>
		<modExtensions>
			<li Class="CombatExtended.PartialArmorExt">
				<stats>
					<li>
						<ArmorRating_Sharp>0.60</ArmorRating_Sharp>
						<parts>
							<li>Neck</li>
						</parts>
					</li>
					<li>
						<ArmorRating_Blunt>0.60</ArmorRating_Blunt>
						<parts>
							<li>Neck</li>
						</parts>
					</li>
				</stats>
			</li>
		</modExtensions>
		<tradeTags>
			<li>Armor</li>
		</tradeTags>
	</ThingDef>

	
	<!-- ==================== Frag Suit ==================== -->

	<ThingDef ParentName="ApparelMakeableBase">
		<defName>Rosen_Armor_FragSuit</defName>
		<label>frag suit</label>
		<description>A bodysuit padded with armor fabrics, worn under plate carrier for protection of limbs against shrapnel.  Gloves and boots not included.</description>
		<graphicData>
			<texPath>Things/Apparel/CE_FragSuit/FragSuit</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<possessionCount>1</possessionCount>
		<recipeMaker>
			<researchPrerequisite>FlakArmor</researchPrerequisite>
			<unfinishedThingDef>UnfinishedArmoredApparel</unfinishedThingDef>
			<skillRequirements>
				<Crafting>6</Crafting>
			</skillRequirements>
		</recipeMaker>
		<techLevel>Industrial</techLevel>
		<generateCommonality>0.5</generateCommonality>
		<costStuffCount>80</costStuffCount>
		<stuffCategories>
			<li>Fabric</li>
		</stuffCategories>
		<costList>
			<DevilstrandCloth>30</DevilstrandCloth>
		</costList>
		<thingCategories>
			<li>ApparelArmor</li>
		</thingCategories>
		<statBases>
			<MaxHitPoints>200</MaxHitPoints>
			<WorkToMake>16000</WorkToMake>
			<Bulk>7</Bulk>
			<WornBulk>3.0</WornBulk>
			<Mass>3.5</Mass>
			<Flammability>0.6</Flammability>
			<StuffEffectMultiplierArmor>4</StuffEffectMultiplierArmor>
			<ArmorRating_Sharp>1.5</ArmorRating_Sharp>
			<ArmorRating_Blunt>1.0</ArmorRating_Blunt>
			<ArmorRating_Heat>0.1</ArmorRating_Heat>
			<StuffEffectMultiplierInsulation_Cold>0.8</StuffEffectMultiplierInsulation_Cold>
			<StuffEffectMultiplierInsulation_Heat>0.1</StuffEffectMultiplierInsulation_Heat>
			<EquipDelay>5</EquipDelay>
		</statBases>
		<apparel>
			<bodyPartGroups>
				<li>Torso</li>
				<li>Neck</li>
				<li>Shoulders</li>
				<li>Arms</li>
				<li>Legs</li>
			</bodyPartGroups>
			<wornGraphicPath>Things/Apparel/CE_FragSuit/FragSuit</wornGraphicPath>
			<layers>
				<li>OnSkin</li>
			</layers>
			<tags>
				<li>IndustrialMilitaryBasic</li>
				<li>IndustrialMilitaryAdvanced</li>
			</tags>
			<defaultOutfitTags>
				<li>Soldier</li>
			</defaultOutfitTags>
		</apparel>
		<colorGenerator Class="ColorGenerator_Options">
			<options>
				<li>
					<only>(0.47,0.48,0.41,1)</only>
				</li>
			</options>
		</colorGenerator>
		<modExtensions>
			<li Class="CombatExtended.PartialArmorExt">
				<stats>
					<li>
						<ArmorRating_Sharp>0.40</ArmorRating_Sharp>
						<parts>
							<li>Hand</li>
						</parts>
					</li>
					<li>
						<ArmorRating_Blunt>0.50</ArmorRating_Blunt>
						<parts>
							<li>Hand</li>
						</parts>
					</li>
					<li>
						<ArmorRating_Sharp>0.50</ArmorRating_Sharp>
						<parts>
							<li>Foot</li>
						</parts>
					</li>
					<li>
						<ArmorRating_Blunt>0.50</ArmorRating_Blunt>
						<parts>
							<li>Foot</li>
						</parts>
					</li>
				</stats>
			</li>
		</modExtensions>
		<tradeTags>
			<li>Clothing</li>
			<li>Armor</li>
		</tradeTags>

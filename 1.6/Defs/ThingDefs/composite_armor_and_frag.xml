<?xml version="1.0" encoding="UTF-8"?>
<Defs>

	<!-- ==================== Composite Armor ==================== -->

	<ThingDef ParentName="ArmorMachineableBase">
		<defName>Rosen_Apparel_CompositeArmor</defName>
		<label>composite armor</label>
		<description>Ceramic armor vest with all the available coverage extension addon parts, covering the user from neck to toe. It's rather heavy, impractical for prolonged use, mainly for turret gunners and entrance teams.</description>
		<graphicData>
			<texPath>Things/Apparel/CompositeVestExtended/CompositeVestExtended</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<techLevel>Industrial</techLevel>
		<generateCommonality>0.25</generateCommonality>
		<recipeMaker>
			<researchPrerequisite>FlakArmor</researchPrerequisite>
			<skillRequirements>
				<Crafting>5</Crafting>
			</skillRequirements>
			<unfinishedThingDef>UnfinishedTechArmor</unfinishedThingDef>
		</recipeMaker>
		<statBases>
			<WorkToMake>18000</WorkToMake>
			<MaxHitPoints>200</MaxHitPoints>
			<ArmorRating_Sharp>15</ArmorRating_Sharp>
			<ArmorRating_Blunt>22</ArmorRating_Blunt>
			<Mass>18</Mass>
			<Bulk>20</Bulk>
			<WornBulk>8</WornBulk>
			<EquipDelay>5</EquipDelay>
			<Insulation_Cold>20</Insulation_Cold>
		</statBases>
		<thingCategories>
			<li>ApparelArmor</li>
		</thingCategories>
		<costList>
			<Steel>80</Steel>
			<DevilstrandCloth>40</DevilstrandCloth>
			<Cloth>40</Cloth>
		</costList>
		<equippedStatOffsets>
			<CarryBulk>30</CarryBulk>
			<ReloadSpeed>0.1</ReloadSpeed>
		</equippedStatOffsets>
		<apparel>
			<bodyPartGroups>
				<li>Torso</li>
				<li>Neck</li>
				<li>Shoulders</li>
				<li>Arms</li>
				<li>Legs</li>
				<li>Hands</li>
				<li>Feet</li>
			</bodyPartGroups>
			<wornGraphicPath>Things/Apparel/CompositeVestExtended/CompositeVestExtended</wornGraphicPath>
			<layers>
				<li>Middle</li>
				<li>Shell</li>
				<li>Webbing</li>
			</layers>
			<tags>
				<li>IndustrialMilitaryBasic</li>
			</tags>
			<defaultOutfitTags>
				<li>Soldier</li>
			</defaultOutfitTags>
		</apparel>
		<modExtensions>
			<li Class="CombatExtended.PartialArmorExt">
				<stats>
					<li>
						<ArmorRating_Sharp>0.60</ArmorRating_Sharp>
						<parts>
							<li>Neck</li>
						</parts>
					</li>
					<li>
						<ArmorRating_Blunt>0.60</ArmorRating_Blunt>
						<parts>
							<li>Neck</li>
						</parts>
					</li>
					<li>
						<ArmorRating_Sharp>0.75</ArmorRating_Sharp>
						<parts>
							<li>Shoulder</li>
						</parts>
					</li>
					<li>
						<ArmorRating_Blunt>0.75</ArmorRating_Blunt>
						<parts>
							<li>Shoulder</li>
						</parts>
					</li>
					<li>
						<ArmorRating_Sharp>0.60</ArmorRating_Sharp>
						<parts>
							<li>Leg</li>
						</parts>
					</li>
					<li>
						<ArmorRating_Blunt>0.40</ArmorRating_Blunt>
						<parts>
							<li>Leg</li>
						</parts>
					</li>
					<li>
						<ArmorRating_Sharp>0.55</ArmorRating_Sharp>
						<parts>
							<li>Arm</li>
						</parts>
					</li>
					<li>
						<ArmorRating_Blunt>0.40</ArmorRating_Blunt>
						<parts>
							<li>Arm</li>
						</parts>
					</li>
					<li>
						<ArmorRating_Sharp>0.125</ArmorRating_Sharp>
						<parts>
							<li>Hand</li>
						</parts>
					</li>
					<li>
						<ArmorRating_Blunt>0.10</ArmorRating_Blunt>
						<parts>
							<li>Hand</li>
						</parts>
					</li>
					<li>
						<ArmorRating_Sharp>0.14</ArmorRating_Sharp>
						<parts>
							<li>Foot</li>
						</parts>
					</li>
					<li>
						<ArmorRating_Blunt>0.14</ArmorRating_Blunt>
						<parts>
							<li>Foot</li>
						</parts>
					</li>
				</stats>
			</li>
		</modExtensions>
		<colorGenerator Class="ColorGenerator_StandardApparel" />
		<tradeTags>
			<li>Armor</li>
		</tradeTags>
	</ThingDef>

    <ThingDef ParentName="ArmorHelmetMakeableBase">
		<defName>Rosen_Apparel_HeavyCompositeHelmet</defName>
		<label>heavy composite helmet</label>
		<description>A thick, heavy composite helmet with faceshield and a rifle rated forehead plate, worn with a soft armor collar, mainly used by turret gunners.</description>
		<graphicData>
			<texPath>Things/Apparel/HeavyCompositeHelmet/HeavyCompositeHelmet</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>0.7</drawSize>
		</graphicData>
		<techLevel>Industrial</techLevel>
		<generateCommonality>0.2</generateCommonality>
		<recipeMaker>
			<researchPrerequisite>FlakArmor</researchPrerequisite>
			<unfinishedThingDef>UnfinishedTechArmor</unfinishedThingDef>
			<skillRequirements>
				<Crafting>5</Crafting>
			</skillRequirements>
		</recipeMaker>
		<costList>
			<Steel>50</Steel>
			<DevilstrandCloth>30</DevilstrandCloth>
			<Chemfuel>30</Chemfuel>
		</costList>
		<statBases>
			<WorkToMake>18000</WorkToMake>
			<MaxHitPoints>125</MaxHitPoints>
			<Mass>5.0</Mass>
			<ArmorRating_Sharp>12</ArmorRating_Sharp>
			<ArmorRating_Blunt>18</ArmorRating_Blunt>
			<Bulk>6</Bulk>
			<WornBulk>2</WornBulk>
			<ArmorRating_Heat>0.54</ArmorRating_Heat>
			<EquipDelay>1.5</EquipDelay>
		</statBases>
		<equippedStatOffsets>
			<AimingAccuracy>-0.1</AimingAccuracy>
			<Suppressability>-0.10</Suppressability>
		</equippedStatOffsets>
		<apparel>
			<wornGraphicPath>Things/Apparel/HeavyCompositeHelmet/HeavyCompositeHelmet</wornGraphicPath>

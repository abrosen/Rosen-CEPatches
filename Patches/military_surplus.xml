<?xml version="1.0" encoding="utf-8" ?>
<Patch>
	<Operation Class="PatchOperationFindMod">
		<mods>
			<li>Military Surplus Ideo Style Clothes</li>
		</mods>
		<match Class="PatchOperationSequence">
			<operations>
				<li Class="PatchOperationFindMod">
					<mods>
						<li>Combat Extended Armors</li>
					</mods>
					<match Class="PatchOperationSequence">
						<operations>
							<li Class="PatchOperationFindMod">
								<mods>
									<li>Combat Extended Armors</li>
								</mods>
								<match Class="PatchOperationSequence">
									<operations>
										<li Class="PatchOperationFindMod">
											<mods>
												<li>Vanilla Apparel Expanded</li>
											</mods>
											<match Class="PatchOperationSequence">
												<operations>
													<li Class="PatchOperationFindMod">
														<mods>
															<li>The Generic Ammo Experience for Combat Extended</li>
														</mods>
														<match Class="PatchOperationSequence">
															<operations>
																<li Class="PatchOperationRemove">
																	<success>Always</success>
																	<xpath>Defs/StyleCategoryDef/thingDefStyles/li[thingDef="CE_Armor_Jumpsuit"]</xpath>
																</li>
																<li Class="PatchOperationAdd">
																	<xpath>/Defs/StyleCategoryDef[defName="Milsurp"]/thingDefStyles</xpath>
																	<value>
																		<li>
																			<thingDef>VAE_Apparel_Jumpsuit</thingDef>
																			<styleDef>Milsurp_Jumpsuit</styleDef>
																		</li>
																	</value>
																</li>
															</operations>
														</match>
													</li>
												</operations>
											</match>
										</li>
									</operations>
								</match>
							</li>
						</operations>
					</match>
				</li>
			</operations>
		</match>
	</Operation>
</Patch>



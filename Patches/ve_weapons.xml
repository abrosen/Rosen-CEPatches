<?xml version="1.0" encoding="utf-8"?>
<Patch>
	<Operation Class="PatchOperationFindMod">
		<mods>
			<li>Vanilla Weapons Expanded</li>
		</mods>
        <match Class="PatchOperationSequence">
			<operations>
                <li Class="PatchOperationReplace">
					<xpath>Defs/ThingDef[defName="VWE_Gun_BattleRifle"]/verbs</xpath>
					<value>
						<verbs>
							<li Class="CombatExtended.VerbPropertiesCE">
								<recoilAmount>2</recoilAmount>
								<verbClass>CombatExtended.Verb_ShootCE</verbClass>
								<hasStandardCommand>true</hasStandardCommand>
								<defaultProjectile>Bullet_762x51mmNATO_FMJ</defaultProjectile>
								<burstShotCount>5</burstShotCount>
								<ticksBetweenBurstShots>6</ticksBetweenBurstShots>
								<warmupTime>1.1</warmupTime>
								<range>55</range>
								<soundCast>Shot_CE_BattleRifle</soundCast>
								<soundCastTail>GunTail_Heavy</soundCastTail>
								<muzzleFlashScale>9</muzzleFlashScale>
							</li>
						</verbs>
					</value>
				</li>
				<!--Give me back the SMG, Turkler!-->
				<li Class="PatchOperationReplace">
					<xpath>Defs/ThingDef[defName="VWE_Gun_SMG"]/label</xpath>
					<value>
						<label>SMG</label>
					</value>
				</li>
				<li Class="PatchOperationReplace">
					<xpath>Defs/ThingDef[defName="VWE_Gun_SMG"]/description</xpath>
					<value>
						<description>A compact submachine gun. Deadly at close range.</description>
					</value>
				</li>
				<li Class="PatchOperationReplace">
					<xpath>Defs/ThingDef[defName="VWE_Gun_SMG"]/graphicData</xpath>
					<value>
						<graphicData>
							<texPath>Things/WeaponRanged/SMG</texPath>
							<graphicClass>Graphic_Single</graphicClass>
							<drawSize>(1,1)</drawSize>
						</graphicData>
					</value>
				</li>
				<li Class="PatchOperationReplace">
					<xpath>Defs/ThingDef[defName="VWE_Gun_SMG"]/statBases</xpath>
					<value>
						<statBases>
							<WorkToMake>13000</WorkToMake>
							<Mass>2.00</Mass>
							<Bulk>3.25</Bulk>
							<SwayFactor>1.75</SwayFactor>
							<ShotSpread>0.17</ShotSpread>
							<SightsEfficiency>0.70</SightsEfficiency>
							<RangedWeapon_Cooldown>0.36</RangedWeapon_Cooldown>
						</statBases>
					</value>
				</li>
				<li Class="PatchOperationReplace">
					<xpath>Defs/ThingDef[defName="VWE_Gun_SMG"]/costList</xpath>

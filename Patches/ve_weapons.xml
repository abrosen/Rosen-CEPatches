							</skillRequirements>
							<recipeUsers>
								<li>TableMachining</li>
							</recipeUsers>
						</recipeMaker>
					</value>
				</li>
				<li Class="PatchOperationReplace">
					<xpath>Defs/ThingDef[defName="VWE_Gun_LightSMG"]/weaponTags</xpath>
					<value>
						<weaponTags>
							<li>IndustrialGunAdvanced</li>
							<li>CE_Sidearm</li>
							<li>CE_OneHandedWeapon</li>
							<li>CE_AI_AssaultWeapon</li>
							<li>CE_SMG</li>
							<li>bar</li>
						</weaponTags>
					</value>
				</li>
				<li Class="PatchOperationReplace">
					<xpath>Defs/ThingDef[defName="VWE_Gun_ServiceRifle"]/label</xpath>
					<value>
						<label>militia carbine</label>
					</value>
				</li>

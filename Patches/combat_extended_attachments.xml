<?xml version="1.0" encoding="utf-8"?>
<Patch>
	<Operation Class="PatchOperationFindMod">
		<mods>
			<li>Combat Extended Attachments</li>
		</mods>
		<match Class="PatchOperationSequence">
			<operations>
                <li Class="PatchOperationReplace">
					<xpath>Defs/ThingDef[defName="CE_Gun_AKMGL"]/label</xpath>
					<value>
						<label>grenadier militia rifle</label>
					</value>
				</li>
                <li Class="PatchOperationReplace">
					<xpath>Defs/ThingDef[defName="CE_Gun_DoubleBadger"]/label</xpath>
					<value>
						<label>survival rifle</label>
					</value>
				</li>
                <li Class="PatchOperationReplace">
					<xpath>Defs/ThingDef[defName="CE_Gun_DoubleBadger"]/description</xpath>
					<value>
						<description>Ancient combination rifle, with both a rifled and smoothbore barrel present at extremely small calibers.  Often issued to pilots in case of a crash in the wilderness due to its light weight.</description>
					</value>
				</li>
                <li Class="PatchOperationReplace">
					<xpath>Defs/ThingDef[defName="CE_Gun_KSG"]/label</xpath>
					<value>
						<label>combination shotgun</label>
					</value>
				</li>
                <li Class="PatchOperationReplace">
					<xpath>Defs/ThingDef[defName="CE_Gun_LeMatRevolver"]/label</xpath>
					<value>
						<label>combination revolver</label>
					</value>
				</li>
                <li Class="PatchOperationReplace">
					<xpath>Defs/ThingDef[defName="CE_Gun_M16A4GL"]/label</xpath>
					<value>
						<label>grenadier assault rifle</label>
					</value>
				</li>
                <li Class="PatchOperationReplace">
					<xpath>Defs/ThingDef[defName="CE_Gun_Savage_TwentyFourHundred"]/label</xpath>
					<value>
						<label>combination rifle</label>
					</value>
				</li>
                <li Class="PatchOperationReplace">
					<xpath>Defs/ThingDef[defName="CE_Gun_TP_EightyTwo"]/label</xpath>
					<value>
						<label>survival gun</label>
					</value>
				</li>
            </operations>
		</match>
	</Operation>
</Patch>
